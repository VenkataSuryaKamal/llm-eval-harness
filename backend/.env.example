# Copy to .env and fill in what you need. NEVER commit .env.

# development | production   (production hides /docs and warns if APP_API_KEY is empty)
APP_ENV=development

# SQLite by default. For Postgres: postgresql+psycopg://user:pass@host:5432/evals
DATABASE_URL=sqlite:///./data/eval_harness.db

# Provider keys. Leave empty to hide that provider's models.
# Paid (Anthropic may give a small one-time trial credit to new accounts):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# FREE tiers, no credit card (rate limited; see README section 8):
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys
OPENROUTER_API_KEY=      # https://openrouter.ai/settings/keys  (use models ending in :free)
# Fully free and offline: install Ollama, run `ollama pull llama3.2`, then set:
OLLAMA_BASE_URL=         # http://127.0.0.1:11434/v1

# Offline fake models so you can try everything with no keys.
ENABLE_MOCK_MODELS=true

# Model that grades outputs. If it is unavailable, the first available model in
# JUDGE_FALLBACK_MODEL (comma-separated, in order) is used instead.
JUDGE_MODEL=claude-opus-5-5
JUDGE_FALLBACK_MODEL=gpt-4.1,openai/gpt-oss-120b,gemini-3.8-flash,gemini-3.5-flash-lite,qwen3:8b,mock-judge

# Shared secret required in the X-API-Key header. Strongly recommended outside localhost.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000

# Guard-rails against abuse and surprise bills
RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_BYTES=1000000
MAX_CASES_PER_DATASET=500
MAX_MODELS_PER_RUN=6
MAX_CALLS_PER_RUN=1000
MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=60
CONCURRENCY=5
# Parallel calls per free-tier provider, shared by all runs (keeps you under free rate limits)
FREE_TIER_CONCURRENCY=2
